#include <iostream>
#include <vector>
#include <cstdlib>
#include <cstring>

// --- GC Runtime Types ---

// The header of every object allocated on the heap
struct ObjHeader {
    bool marked;
    size_t size;
    ObjHeader* next; // Linked list of all allocated objects
};

// A "Stack Map" generated by the compiler for each function
// It describes where the pointers are in the stack frame
struct StackMap {
    int numRoots;
    // offsets could be added here for precise GC, 
    // for now we assume the frame is an array of void*
};

// A node in the Shadow Stack (one per function call)
struct StackFrame {
    StackFrame* prev;    // Previous frame
    void** roots;        // Array of pointers (local variables) tracked by GC
    int numRoots;
};

// --- Globals ---

ObjHeader* allObjects = nullptr;  // Head of the object list
StackFrame* topFrame = nullptr;   // Top of the shadow stack
size_t bytesAllocated = 0;
size_t nextGCThreshold = 1024 * 1024; // Start with 1MB

// --- Implementation ---

void mark(ObjHeader* obj) {
    if (!obj || obj->marked) return;
    
    obj->marked = true;
    
    // Scan fields: simplified assumption
    // We assume the object body is just an array of pointers for this prototype.
    // In a real implementation, we need a ClassMap to know which fields are pointers.
    // For now, this is a "Conservative" scan of the object body.
    
    void** fields = (void**)(obj + 1);
    size_t numFields = obj->size / sizeof(void*);
    
    for (size_t i = 0; i < numFields; i++) {
        void* field = fields[i];
        if (field) {
            // Check if this looks like a heap pointer (naive check)
            // In a precise GC, we'd know exactly.
            // For this prototype, we'll cast to header and mark.
            // WARNING: unsafe without precise layout info.
            // Let's assume ONLY pointers are stored for now or use Layout info passed in alloc.
             
            // To make this safe for mixed int/ptr classes without layout info:
            // We need the class descriptor. 
            // Let's assume the first word of every object is a vtable/type-id if we want precise GC.
        }
    }
}

void gc_collect() {
    // 1. Mark Roots
    StackFrame* frame = topFrame;
    while (frame) {
        for (int i = 0; i < frame->numRoots; i++) {
            if (frame->roots[i]) {
                // Adjust pointer back to header
                ObjHeader* header = ((ObjHeader*)frame->roots[i]) - 1;
                mark(header);
            }
        }
        frame = frame->prev;
    }

    // 2. Sweep
    ObjHeader** current = &allObjects;
    while (*current) {
        ObjHeader* obj = *current;
        if (!obj->marked) {
            // Unreached: Free
            *current = obj->next;
            bytesAllocated -= obj->size;
            free(obj);
        } else {
            // Reached: Unmark for next time
            obj->marked = false;
            current = &obj->next;
        }
    }
}

extern "C" {

// Called by IRGenerator at start of function
void gc_enter(StackFrame* frame, void** roots, int num) {
    frame->roots = roots;
    frame->numRoots = num;
    frame->prev = topFrame;
    topFrame = frame;
    
    // Initialize roots to null so we don't mark garbage
    memset(roots, 0, num * sizeof(void*));
}

// Called by IRGenerator at end of function
void gc_exit() {
    if (topFrame) {
        topFrame = topFrame->prev;
    }
}

// Replacement for malloc
void* gc_alloc(size_t size) {
    if (bytesAllocated + size > nextGCThreshold) {
        gc_collect();
        // Simple heuristic to grow heap
        if (bytesAllocated + size > nextGCThreshold) {
            nextGCThreshold = bytesAllocated + size * 2;
        }
    }

    // Allocate Header + Body
    size_t totalSize = sizeof(ObjHeader) + size;
    void* mem = malloc(totalSize);
    if (!mem) {
        std::cerr << "Out of memory" << std::endl;
        exit(1);
    }

    ObjHeader* header = (ObjHeader*)mem;
    header->marked = false;
    header->size = size;
    header->next = allObjects;
    allObjects = header;
    
    bytesAllocated += size;

    // Return pointer to body
    return (void*)(header + 1);
}

} // extern "C"
