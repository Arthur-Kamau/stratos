{
    "name": "stratos-language",
    "displayName": "Stratos Language",
    "description": "Language support for Stratos",
    "publisher": "arthurKamau",
    "version": "0.1.3",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Themes"
    ],
    "activationEvents": [
        "onLanguage:stratos"
    ],
    "publisher": "arthur-kamau",
    "repository": {
        "type": "git",
        "url": "https://github.com/Arthur-Kamau/stratos.git",
        "branch": "master"
    },
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "stratos",
                "aliases": [
                    "Stratos",
                    "stratos"
                ],
                "extensions": [
                    ".st"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "hocon",
                "aliases": [
                    "HOCON",
                    "hocon"
                ],
                "extensions": [
                    ".conf"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "stratos",
                "scopeName": "source.stratos",
                "path": "./syntaxes/stratos.tmLanguage.json"
            },
            {
                "language": "hocon",
                "scopeName": "source.hocon",
                "path": "./syntaxes/hocon.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "stratos",
                "path": "./snippets/stratos.json"
            }
        ],
        "themes": [
            {
                "label": "Stratos Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/stratos-dark-theme.json"
            }
        ],
        "configuration": {
            "title": "Stratos",
            "properties": {
                "stratosLanguageServer.compilerPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Stratos compiler executable. Leave empty to auto-detect."
                },
                "stratosLanguageServer.maxNumberOfProblems": {
                    "type": "number",
                    "default": 1000,
                    "description": "Maximum number of problems to report."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p .",
        "watch": "tsc -w -p .",
        "update-stdlib": "node scripts/update-stdlib.js"
    },
    "devDependencies": {
        "@types/node": "^16.11.7",
        "@types/vscode": "^1.75.0",
        "typescript": "^4.9.0"
    },
    "dependencies": {
        "hocon-parser": "^1.0.1",
        "vscode-languageclient": "^8.1.0",
        "vscode-languageserver": "^8.1.0",
        "vscode-languageserver-textdocument": "^1.0.8"
    }
}
