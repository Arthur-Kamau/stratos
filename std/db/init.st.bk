// SQLite Database Support for Stratos
// Simple procedural API (wraps native C++ functions)
package db;

// Open a SQLite database connection
// Returns a database handle
//
// Example:
//   val dbHandle = db.open("mydb.db");
//   val memHandle = db.open(":memory:");
fn open(path: string) any {
    return __sqlite_open(path);
}

// Close a database connection
fn close(handle: any) {
    __sqlite_close(handle);
}

// Execute a SQL statement that doesn't return rows (DDL, INSERT, UPDATE, DELETE)
// Returns the number of rows affected
//
// Example:
//   db.exec(dbHandle, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)");
fn exec(handle: any, sql: string) int {
    return __sqlite_exec(handle, sql);
}

// Query executes a SQL statement that returns rows
// Returns a statement handle for iterating results
//
// Example:
//   val stmtHandle = db.query(dbHandle, "SELECT * FROM users");
fn query(handle: any, sql: string) any {
    return __sqlite_query(handle, sql);
}

// Prepare creates a prepared statement for later execution
fn prepare(handle: any, sql: string) any {
    return __sqlite_prepare(handle, sql);
}

// Step through query results
// Returns true if there is a row, false if no more rows
fn step(stmtHandle: any) bool {
    return __sqlite_step(stmtHandle);
}

// Get an integer column value by index (0-based)
fn columnInt(stmtHandle: any, index: int) int {
    return __sqlite_column_int(stmtHandle, index);
}

// Get a double column value by index
fn columnDouble(stmtHandle: any, index: int) double {
    return __sqlite_column_double(stmtHandle, index);
}

// Get a string column value by index
fn columnString(stmtHandle: any, index: int) string {
    return __sqlite_column_string(stmtHandle, index);
}

// Check if a column is NULL
fn columnIsNull(stmtHandle: any, index: int) bool {
    return __sqlite_column_is_null(stmtHandle, index);
}

// Get the number of columns in the result
fn columnCount(stmtHandle: any) int {
    return __sqlite_column_count(stmtHandle);
}

// Get the name of a column by index
fn columnName(stmtHandle: any, index: int) string {
    return __sqlite_column_name(stmtHandle, index);
}

// Close a statement/rows handle
fn closeRows(stmtHandle: any) {
    __sqlite_rows_close(stmtHandle);
}

// Bind an integer parameter to a prepared statement (1-indexed)
fn bindInt(stmtHandle: any, index: int, value: int) {
    __sqlite_bind_int(stmtHandle, index, value);
}

// Bind a double parameter to a prepared statement
fn bindDouble(stmtHandle: any, index: int, value: double) {
    __sqlite_bind_double(stmtHandle, index, value);
}

// Bind a string parameter to a prepared statement
fn bindString(stmtHandle: any, index: int, value: string) {
    __sqlite_bind_string(stmtHandle, index, value);
}

// Bind NULL parameter to a prepared statement
fn bindNull(stmtHandle: any, index: int) {
    __sqlite_bind_null(stmtHandle, index);
}

// Execute a prepared statement (for INSERT, UPDATE, DELETE)
// Returns the number of rows affected
fn stmtExec(stmtHandle: any) int {
    return __sqlite_stmt_exec(stmtHandle);
}

// Reset a prepared statement to be executed again
fn stmtReset(stmtHandle: any) {
    __sqlite_stmt_reset(stmtHandle);
}

// Close a prepared statement
fn stmtClose(stmtHandle: any) {
    __sqlite_stmt_close(stmtHandle);
}

// Get the last inserted row ID
fn lastInsertId(handle: any) int {
    return __sqlite_last_insert_id(handle);
}

// Get the number of changes made by the last statement
fn changes(handle: any) int {
    return __sqlite_changes(handle);
}

// ============================================================================
// Native function declarations (implemented in C++)
// ============================================================================

fn __sqlite_open(path: string) any;
fn __sqlite_close(handle: any) void;
fn __sqlite_exec(handle: any, sql: string) int;
fn __sqlite_query(handle: any, sql: string) any;
fn __sqlite_prepare(handle: any, sql: string) any;
fn __sqlite_bind_int(handle: any, index: int, value: int) void;
fn __sqlite_bind_double(handle: any, index: int, value: double) void;
fn __sqlite_bind_string(handle: any, index: int, value: string) void;
fn __sqlite_bind_null(handle: any, index: int) void;
fn __sqlite_stmt_exec(handle: any) int;
fn __sqlite_stmt_reset(handle: any) void;
fn __sqlite_stmt_close(handle: any) void;
fn __sqlite_step(handle: any) bool;
fn __sqlite_column_int(handle: any, index: int) int;
fn __sqlite_column_double(handle: any, index: int) double;
fn __sqlite_column_string(handle: any, index: int) string;
fn __sqlite_column_index(handle: any, name: string) int;
fn __sqlite_column_is_null(handle: any, index: int) bool;
fn __sqlite_column_count(handle: any) int;
fn __sqlite_column_name(handle: any, index: int) string;
fn __sqlite_rows_close(handle: any) void;
fn __sqlite_last_insert_id(handle: any) int;
fn __sqlite_changes(handle: any) int;
