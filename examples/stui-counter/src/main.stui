// stui-counter: Counter app with state management
import "std/gui";

component Counter {
    state count: int = 0;

    view {
        Column(alignment: "center", spacing: 16) {
            Text("Count: ${count}") {
                fontSize: 24;
                color: "white";
            }
            Row(spacing: 8) {
                Button("Increment") {
                    onClick: {
                        count += 1;
                    }
                }
                Button("Decrement") {
                    onClick: {
                        count -= 1;
                    }
                }
                Button("Reset") {
                    onClick: {
                        count = 0;
                    }
                }
            }
        }
    }
}

component App {
    view {
        Window(title: "Counter App", width: 800, height: 600) {
            Counter()
        }
    }
}
