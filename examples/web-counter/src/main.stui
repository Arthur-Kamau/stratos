import "std/gui";

component Counter {
    state count: int = 0;

    view {
        Column(alignment: "center", spacing: 16) {
            Text("Count: ${count}") {
                fontSize: 24;
                color: "white";
            }
            Row(spacing: 8) {
                Button("+1") {
                    onClick: { count += 1; }
                }
                Button("-1") {
                    onClick: { count -= 1; }
                }
                Button("Reset") {
                    onClick: { count = 0; }
                }
            }
        }
    }
}

component App {
    view {
        Window(title: "Web Counter", width: 800, height: 600) {
            Center {
                Counter()
            }
        }
    }
}
